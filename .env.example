APP_NAME=NoniKos
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nonikos
DB_USERNAME=root
DB_PASSWORD=

# Absolute paths to MariaDB/MySQL CLI used by backup & restore (optional).
# DB_DUMP_BINARY=C:\xampp\mysql\bin\mysqldump.exe
# DB_MYSQL_BINARY=C:\xampp\mysql\bin\mysql.exe

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@nonikos.test"
MAIL_FROM_NAME="${APP_NAME}"

# Integrations — leave empty to run in sandbox/simulation mode.
# Nothing is ever reported as sent/paid while these are empty.
PAYMENT_GATEWAY_KEY=
PAYMENT_GATEWAY_BASE_URL=
PAYMENT_GATEWAY_WEBHOOK_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
